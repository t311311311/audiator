# Audiator Auth Server — environment configuration
#
# Copy this file to `.env` and set a fresh, unique secret. NEVER commit `.env`.
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The server refuses to start if AUDIATOR_SECRET_KEY is not set.
AUDIATOR_SECRET_KEY=

# Optional: database backend. Defaults to a local SQLite file (audiator.db).
# For Postgres: postgresql+psycopg://user:pass@host:5432/audiator
# DATABASE_URL=

# Optional: internal URLs of the ASR / translation services the gateway proxies
# to. Defaults below. Point these at localhost once the public ports are closed.
# WHISPER_URL=http://127.0.0.1:8000
# TRANSLATE_URL=http://127.0.0.1:5000

# Paid subscriptions. Leave off until payments are verified server-side against
# the provider's webhook (AUD-15): the endpoint takes the payment id on trust,
# so switching this on beforehand lets anyone grant themselves a subscription.
# PAYMENTS_ENABLED=0

# Optional: daily transcription allowance by tier (seconds).
# FREE_DAILY_SECONDS=3600    # the 60-minute gift every user gets

# Optional: rate limits & usage quota (AUD-13). Defaults shown.
# TRIAL_PER_IP_DAY=10        # max trial requests per IP per 24h
# ASR_PER_MIN=20             # max /asr requests per device per minute
# TRANSLATE_PER_MIN=40       # max /translate requests per device per minute
# ASR_DAILY_SECONDS=14400    # max transcribed audio seconds per device per day (4h)

# Accounts by email (step 4). Mail for the sign-in codes: SMTP_PASSWORD is a
# Gmail *app password*. Without a mailbox the server refuses to send codes;
# MAIL_DEV_PRINT=1 (development only — `npm start` sets it) prints them instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=audiatorr@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM="Audiator <audiatorr@gmail.com>"
# MAIL_DEV_PRINT=0
# ACCOUNTS_DATABASE_URL=sqlite:///accounts.db
# ADMIN_EMAILS=t311311311@gmail.com
# FREE_DAILY_SECONDS_V2=7200
